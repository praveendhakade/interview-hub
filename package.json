{
  "name": "interview-preparation-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run generate:pdfs && npm run validate:pdfs",
    "dev": "next dev --webpack",
    "prebuild": "npm run generate:pdfs && npm run validate:pdfs",
    "build": "next build --webpack",
    "start": "node scripts/start-production.mjs",
    "generate:pdfs": "node --import tsx/esm scripts/generate-pdfs.ts",
    "validate:pdfs": "node --import tsx/esm scripts/validate-pdfs.ts",
    "validate:seo": "node --import tsx/esm scripts/validate-seo.ts",
    "validate:production": "node --import tsx/esm scripts/validate-production.ts",
    "validate:browser": "node scripts/validate-browser.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsc --project tsconfig.test.json && node .test-dist/scripts/validate-content.js",
    "pretest": "npm run generate:pdfs",
    "test": "tsc --project tsconfig.test.json && node --import=./.test-dist/tests/dom-setup.js --test --test-concurrency=1 --experimental-test-isolation=none .test-dist/tests/content.test.js .test-dist/tests/browsing.test.js && node --test .test-dist/tests/pdf.test.js .test-dist/tests/seo.test.js"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "next": "^16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.0.0"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "pdf-parse": "2.4.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
